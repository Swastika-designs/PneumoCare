# Copy to .env and adjust if needed. All values are optional.

# Folders (relative paths are resolved from the project root)
PNEUMOCARE_DATA_DIR=data
PNEUMOCARE_MODELS_DIR=models
PNEUMOCARE_REPORTS_DIR=reports
PNEUMOCARE_UPLOADS_DIR=data/uploads

# SQLite database (default: data/pneumocare.db)
PNEUMOCARE_DATABASE_URL=

# Comma-separated origins allowed to call the API directly (the Vite proxy does not need this)
PNEUMOCARE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum upload size in MB
PNEUMOCARE_MAX_UPLOAD_MB=10
